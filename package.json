{
  "name": "material-plus-ui",
  "version": "1.6.0",
  "description": "A React component library implementing Material Design 3 — the components other Material libraries do not ship, and wider versions of the ones they do. Built on Base UI and Tailwind CSS v4, themed with CSS custom properties so it can coexist with an existing Material setup. ESM only, types included.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "dist/index.d.ts",
  "author": "CDGet <jooy2.contact@gmail.com>",
  "license": "MIT",
  "homepage": "https://material-plus.cdget.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jooy2/material-plus.git"
  },
  "bugs": {
    "url": "https://github.com/jooy2/material-plus/issues"
  },
  "scripts": {
    "build": "npm run format:fix && node scripts/clean-dist.mjs && tsc --project tsconfig.prod.json && node scripts/specify-imports.mjs && node scripts/annotate-pure.mjs && npm run minify && node scripts/mark-client.mjs && node scripts/build-styles.mjs && node scripts/build-split-styles.mjs && node scripts/measure-bundle.mjs",
    "lint": "eslint . --ext .js,.ts .",
    "lint:fix": "eslint . --ext .js,.ts --fix .",
    "minify": "terser-glob 'dist/**/*.js' --config-file terser.config.json",
    "measure": "node scripts/measure-bundle.mjs",
    "prepare": "npm run build",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "docs:changelog": "node scripts/copy-changelog.mjs",
    "docs:dev": "npm run build && npm run docs:changelog && vitepress dev docs",
    "docs:build": "npm run build && npm run docs:changelog && vitepress build docs",
    "docs:serve": "npm run build && npm run docs:build && vitepress serve docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.prod.json --noEmit && tsc --project test/tsconfig.json && tsc --project docs/tsconfig.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "module": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./constants/icons": {
      "types": "./dist/constants/icons.d.ts",
      "module": "./dist/constants/icons.js",
      "default": "./dist/constants/icons.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "module": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "module": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "module": "./dist/locales/index.js",
      "default": "./dist/locales/index.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "module": "./dist/locales/*.js",
      "default": "./dist/locales/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./styles/*.css": "./dist/styles/*.css"
  },
  "typesVersions": {
    "*": {
      "index.d.ts": [
        "dist/index.d.ts"
      ]
    }
  },
  "keywords": [
    "material-plus-ui",
    "material-plus",
    "material-design",
    "material-design-3",
    "md3",
    "react",
    "reactjs",
    "react-components",
    "react-ui",
    "ui",
    "ui-kit",
    "ui-library",
    "ui-components",
    "component-library",
    "components",
    "design-system",
    "frontend",
    "web",
    "typescript",
    "tsx",
    "esm",
    "accessible",
    "accessibility",
    "a11y",
    "aria",
    "dark-mode",
    "theming",
    "tailwindcss",
    "base-ui",
    "lucide",
    "icon",
    "textfield",
    "input",
    "form",
    "ime",
    "composition"
  ],
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "terser-glob": "^1.2.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitepress-i18n": "^1.4.0",
    "vitepress-sidebar": "^1.39.0",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  },
  "dependencies": {
    "lucide-react": "^1.37.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.7.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}

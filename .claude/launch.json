{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "docs",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "docs-dist",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd docs && npx vitepress serve --port 4373"
      ],
      "port": 4373
    }
  ]
}

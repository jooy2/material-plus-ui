{
  "compilerOptions": {
    "target": "esnext",
    "module": "Preserve",
    "moduleDetection": "force",
    "lib": ["esnext", "dom", "dom.iterable"],
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "jsx": "react-jsx",
    "strict": true,
    "newLine": "lf"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "eslint.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "test"]
}

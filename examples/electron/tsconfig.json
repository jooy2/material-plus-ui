{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "material-plus-ui": ["./node_modules/material-plus-ui/dist/index.d.ts"],
      "material-plus-ui/locales": ["./node_modules/material-plus-ui/dist/locales/index.d.ts"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src", "test", "vite.config.ts", "playwright.config.ts"]
}
